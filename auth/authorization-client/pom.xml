<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/xsd/maven-4.0.0.xsd http://maven.apache.org/POM/4.0.0">
    <parent>
        <artifactId>core</artifactId>
        <relativePath>../../pom.xml</relativePath>
        <groupId>io.github.swansrp</groupId>
        <version>${jarVersion}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
            <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
</properties>

    <artifactId>authorization-client</artifactId>
    <name>authorization-client</name>
    <version>${jarVersion}</version>
    <packaging>jar</packaging>

    

    <dependencies>
        <!-- 🔴 client 纪律：禁依赖 authorization(server)——dep-direction-check.mjs 断言②（server→client 单向，
             server pom 是唯一下游）。T2.3c 起 client 装客户端运行时（AuthInterceptor/TokenServiceImpl 等），
             在 api＋kernel 之外新增运行时件直接使用面（均按实际 import 最小集）：
             redis/platform＝TokenServiceImpl（RedisService＋SysConfigCacheService）；
             spring-web/spring-webmvc＝AuthInterceptor（MVC 拦截器）与 AuthorizationConfigureAdapter。 -->
        <dependency>
            <groupId>io.github.swansrp</groupId>
            <artifactId>authorization-api</artifactId>
            <version>${authorization-api.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.swansrp</groupId>
            <artifactId>kernel</artifactId>
            <version>${kernel.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.swansrp</groupId>
            <artifactId>platform</artifactId>
            <version>${platform.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.swansrp</groupId>
            <artifactId>redis</artifactId>
            <version>${redis.version}</version>
        </dependency>
        <!-- 直接使用面显式声明（版本 spring-boot-starter-parent BOM 管理；宿主必带 web 栈） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
        </dependency>
        <!-- 子系统自签会话的身份源（SubsystemSessionService，2026-11-04 合并轮）：
             🔴 optional——主系统经 authorization→authorization-client 拿到本 jar 但不继承镜像
             （不建 idm_* 表、会话自动装配退位）；子系统显式依赖 identity-mirror（epc-ai-common
             已声明），装配才生效。 -->
        <dependency>
            <groupId>io.github.swansrp</groupId>
            <artifactId>identity-mirror</artifactId>
            <version>${identity-mirror.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 2026-11-17 验证码上提引入 JUnit5 用例；本模块既有 14 个 JUnit4 测试类（92 用例）照跑：
             SB 2.7 starter-test 不含 vintage 引擎，显式补上（配合下面 platform provider）。 -->
        <dependency>
            <groupId>org.junit.vintage</groupId>
            <artifactId>junit-vintage-engine</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 传递依赖含 JUnit4 时 surefire 会选错 provider，表现为 Tests run: 0（必须显式指定）——
                 与 ai/agent-capability 等模块同款；JUnit4 用例由 vintage 引擎继续执行。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                    </includes>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>org.apache.maven.surefire</groupId>
                        <artifactId>surefire-junit-platform</artifactId>
                        <version>2.22.2</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>
</project>
