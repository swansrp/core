<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/xsd/maven-4.0.0.xsd http://maven.apache.org/POM/4.0.0">
    <parent>
        <artifactId>core</artifactId>
        <relativePath>../../pom.xml</relativePath>
        <groupId>com.bidr</groupId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <artifactId>authorization-client</artifactId>
    <version>${jarVersion}</version>
    <packaging>jar</packaging>

    <profiles>
        <profile>
            <id>development</id>
            <properties>
                <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
                <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
                <java.version>1.8</java.version>
                <jarVersion>0.0.1-SNAPSHOT</jarVersion>
                <kernel.version>${jarVersion}</kernel.version>
                <authorization-api.version>${jarVersion}</authorization-api.version>
                <platform.version>${jarVersion}</platform.version>
                <redis.version>${jarVersion}</redis.version>
                <identity-mirror.version>${jarVersion}</identity-mirror.version>
            </properties>
        </profile>
        <profile>
            <id>public-snapshots</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
                <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
                <java.version>1.8</java.version>
                <jarVersion>0.0.1-SNAPSHOT</jarVersion>
                <kernel.version>20261104135926-98</kernel.version>
                <authorization-api.version>20261104135926-98</authorization-api.version>
                <platform.version>20261104135926-98</platform.version>
                <redis.version>20261104135926-98</redis.version>
                <!-- identity-mirror 生于 11-03，无 11-01 的 dated 快照；与消费方（epc core.version）
                     同用 0.0.1-SNAPSHOT 口径，reactor 内亦对齐 -->
                <identity-mirror.version>0.0.1-SNAPSHOT</identity-mirror.version>
            </properties>
        </profile>
    </profiles>

    <dependencies>
        <!-- 🔴 client 纪律：禁依赖 authorization(server)——dep-direction-check.mjs 断言②（server→client 单向，
             server pom 是唯一下游）。T2.3c 起 client 装客户端运行时（AuthInterceptor/TokenServiceImpl 等），
             在 api＋kernel 之外新增运行时件直接使用面（均按实际 import 最小集）：
             redis/platform＝TokenServiceImpl（RedisService＋SysConfigCacheService）；
             spring-web/spring-webmvc＝AuthInterceptor（MVC 拦截器）与 AuthorizationConfigureAdapter。 -->
        <dependency>
            <groupId>com.bidr</groupId>
            <artifactId>authorization-api</artifactId>
            <version>${authorization-api.version}</version>
        </dependency>
        <dependency>
            <groupId>com.bidr</groupId>
            <artifactId>kernel</artifactId>
            <version>${kernel.version}</version>
        </dependency>
        <dependency>
            <groupId>com.bidr</groupId>
            <artifactId>platform</artifactId>
            <version>${platform.version}</version>
        </dependency>
        <dependency>
            <groupId>com.bidr</groupId>
            <artifactId>redis</artifactId>
            <version>${redis.version}</version>
        </dependency>
        <!-- 直接使用面显式声明（版本 spring-boot-starter-parent BOM 管理；宿主必带 web 栈） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
        </dependency>
        <!-- 子系统自签会话的身份源（SubsystemSessionService，2026-11-04 合并轮）：
             🔴 optional——主系统经 authorization→authorization-client 拿到本 jar 但不继承镜像
             （不建 idm_* 表、会话自动装配退位）；子系统显式依赖 identity-mirror（epc-ai-common
             已声明），装配才生效。 -->
        <dependency>
            <groupId>com.bidr</groupId>
            <artifactId>identity-mirror</artifactId>
            <version>${identity-mirror.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
