<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>core</artifactId>
        <relativePath>../../pom.xml</relativePath>
        <groupId>com.bidr</groupId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>authorization</artifactId>
    <version>${jarVersion}</version>
    <packaging>jar</packaging>

    <profiles>
        <profile>
            <id>development</id>
            <properties>
                <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
                <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
                <java.version>1.8</java.version>
                <jarVersion>0.0.1-SNAPSHOT</jarVersion>
                <kernel.version>${jarVersion}</kernel.version>
                <authorization-api.version>${jarVersion}</authorization-api.version>
                <platform.version>${jarVersion}</platform.version>
                <redis.version>${jarVersion}</redis.version>
                <email.version>${jarVersion}</email.version>
            </properties>
        </profile>
        <profile>
            <id>public-snapshots</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
                <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
                <java.version>1.8</java.version>
                <kernel.version>20261101110847-97</kernel.version>
                <!-- t23 线 authorization-api 拆分新增：CI 尚未发过 api 件的新版本，暂留 88（2026-11-01 合流） -->
                <authorization-api.version>20261101110847-97</authorization-api.version>
                <platform.version>20261101110847-97</platform.version>
                <redis.version>20261101110847-97</redis.version>
                <email.version>20261101110847-97</email.version>
            </properties>
        </profile>
    </profiles>

    <dependencies>
        <dependency>
            <groupId>com.bidr</groupId>
            <artifactId>kernel</artifactId>
            <version>${kernel.version}</version>
        </dependency>
        <!-- T2.3a 拆分：authorization-api（同包名类型面正源）。本模块=server，经此传递供货给
             11 个存量依赖方（它们 pom 一行不改）；api 禁反向依赖本模块（见 tools/dep-direction-check.mjs） -->
        <dependency>
            <groupId>com.bidr</groupId>
            <artifactId>authorization-api</artifactId>
            <version>${authorization-api.version}</version>
        </dependency>
        <!-- T1.0 棒1：TenantResolver SPI 契约（pack-spi 是跨仓契约件，版本恒 0.0.1-SNAPSHOT——
             聚合件族无 dated 发布口径，与 pack-spi pom 对 com.bidr:core 的写法同口径；
             依赖方向 core→pack-spi 是"内核实现 SPI"的正向形态，pack-spi 不反依 core 任何 jar） -->
        <dependency>
            <groupId>com.bidr</groupId>
            <artifactId>pack-spi</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.bidr</groupId>
            <artifactId>platform</artifactId>
            <version>${platform.version}</version>
        </dependency>
        <dependency>
            <groupId>com.bidr</groupId>
            <artifactId>email</artifactId>
            <version>${email.version}</version>
        </dependency>
        <dependency>
            <groupId>com.bidr</groupId>
            <artifactId>redis</artifactId>
            <version>${redis.version}</version>
        </dependency>
        <!-- 审计默认拦截模式（AuditTrailAutoAdvisor）直接使用 web 取数 API：HttpServletRequest/
             HandlerMethod/RequestContextHolder。版本由 spring-boot-starter-parent BOM 管理；
             宿主必带 spring-web（kernel 依赖 spring-boot-starter-web），此处显式声明直接使用面 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/java</directory>
                <includes>
                    <include>**/*.xml</include>
                </includes>
                <filtering>false</filtering>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
        </resources>
    </build>
</project>
