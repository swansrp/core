<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.swansrp</groupId>
    <artifactId>core</artifactId>
    <version>${jarVersion}</version>
    <!-- ============================================================
         兼容性纪律(1.8/17 并存期):
         1. 除 ai/* 外,本仓库源码必须保持 Java 8 语法/API 兼容——下游 1.8
            项目在各自 reactor 用 JDK8 工具链现编本仓库,字节码级别由各项目
            构建决定,本仓库不发布二进制产物,只有源码约束。
         2. 禁止引入 Java 9+ 语法(records/sealed/switch 表达式)与 API
            (如 String.isBlank、List.of)。防呆闸=JDK8 工具链编译:违规当场
            报错;JDK17 工具链反而查不出(会延迟引爆在 1.8 项目构建里)。
         3. ai/* 四模块与 lowcode/insight(aim 17 区)已移出默认 reactor,随 ai17 profile
            按 JDK 条件自动激活(2026-11-05 9bd0e890),其源码可用 17 语法/API,
            必须用 JDK17 工具链构建。
         4. 改动验证方式:非 ai 模块用 JDK8 工具链 mvn compile 一次。
         全 fleet 切 17 或 SB3 分叉时,本注释随纪律一并解除。
         ============================================================ -->
    <modules>
        <module>base/kernel</module>
        <module>base/platform</module>
        <module>base/task</module>
        <module>base/audit</module>
        <module>base/notification</module>
        <module>tool/xxl-job</module>
        <module>comm/email</module>
        <module>store/redis</module>
        <module>auth/authorization</module>
        <module>auth/authorization-api</module>
        <module>auth/admin-api</module>
        <module>auth/authorization-client</module>
        <module>auth/identity-mirror</module>
        <module>comm/sms</module>
        <module>comm/mqtt</module>
        <module>store/neo4j</module>
        <module>auth/admin</module>
        <module>store/oss</module>
        <module>store/blob</module>
        <module>comm/wechat</module>
        <module>comm/feishu</module>
        <module>tool/ocr</module>
        <module>tool/qichacha</module>
        <module>store/mongo</module>
        <module>comm/socket-io</module>
        <module>store/elasticsearch</module>
        <module>lowcode/forge</module>
        <module>comm/kafka</module>
        <module>store/td</module>
        <module>tool/document</module>
        <module>tool/gotenberg</module>
        <module>tool/mineru</module>
        <module>engine/file-parse</module>
    </modules>
    <packaging>pom</packaging>

    <name>core</name>
    <description>Bidr Core</description>

    <!-- Central 发布元数据（2026-11-09 定案 io.github.swansrp 命名空间）：Portal 校验硬性要求
         url/licenses/developers/scm，各模块经继承生效；scm 指向 gitee 正源（公开源码地） -->
    <url>https://gitee.com/swansrp/core</url>
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <name>swansrp</name>
            <organization>bidr</organization>
        </developer>
    </developers>
    <scm>
        <url>https://gitee.com/swansrp/core</url>
        <connection>scm:git:https://gitee.com/swansrp/core.git</connection>
        <developerConnection>scm:git:git@gitee.com:swansrp/core.git</developerConnection>
    </scm>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.18</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <properties>
        <jarVersion>0.0.1-SNAPSHOT</jarVersion>

        <!-- 混合字节码模型（2026-11-09 拍板，修正 11-08 的全量统一 17）：老项目必须 JDK8 且不用
             ai 模块——默认编译目标 1.8（非 ai 32 模块），ai17 五模块各自在模块 pom override 17；
             工具链仍统一 JDK17（javac17 交叉编出 1.8 字节码）。surefire 的 jdk9plus-module-opens
             profile 按 JDK≥9 自动激活注入四包 opens，测试期零额外配置 -->
        <java.version>1.8</java.version>

        <!-- ============ 版本开关(双 profile 退役后的唯一机制) ============
             默认 0.0.1-SNAPSHOT = 本地源码模式(reactor 全量现编,零参数);
             发布火车:-DjarVersion=<戳> 一根旗子——模块版本与兄弟互 pin 全部对齐该戳
             (core.dist.version 跟随 jarVersion);消费方再用 -Dcore.dist.version=<同一戳> 锁定。
             (2026-11-09 曾试改 CI-friendly revision,因 Jenkins 火车链/脚手架全家依赖
              jarVersion 且 devops 共享库禁改而回退——旗标名是生态契约,勿再动。)
             下列兄弟属性全部由此一根派生,模块 pom 不再各自携带版本。 -->
        <core.dist.version>${jarVersion}</core.dist.version>
        <admin-api.version>${core.dist.version}</admin-api.version>
        <admin.version>${core.dist.version}</admin.version>
        <authorization-api.version>${core.dist.version}</authorization-api.version>
        <authorization-client.version>${core.dist.version}</authorization-client.version>
        <authorization.version>${core.dist.version}</authorization.version>
        <base-task.version>${core.dist.version}</base-task.version>
        <document.version>${core.dist.version}</document.version>
        <email.version>${core.dist.version}</email.version>
        <forge.version>${core.dist.version}</forge.version>
        <identity-mirror.version>${core.dist.version}</identity-mirror.version>
        <kernel.version>${core.dist.version}</kernel.version>
        <llm.version>${core.dist.version}</llm.version>
        <mineru.version>${core.dist.version}</mineru.version>
        <mongo.version>${core.dist.version}</mongo.version>
        <oss.version>${core.dist.version}</oss.version>
        <platform.version>${core.dist.version}</platform.version>
        <redis.version>${core.dist.version}</redis.version>

        <!-- 测试 JVM 的模块 opens：JDK9+ 由下方 jdk9plus-module-opens profile 填值（spring-cglib
             生成代理需 opens java.lang 的 ClassLoader.defineClass，MyBatis 深反射需
             java.lang.reflect/util/invoke）；JDK8 构建保持空，surefire argLine 不带 JDK9+ 参数 -->
        <jdk.module.opens></jdk.module.opens>
    </properties>

    <!-- AI 17 区:ai/* 四模块＋lowcode/insight 独立条件组,JDK17 工具链构建(默认 reactor 不含,1.8 项目零感知) -->
    <profiles>
        <profile>
            <id>ai17</id>
            <activation>
                <!-- JDK≥17 工具链自动激活:17 世界五模块进 reactor;JDK8 工具链自动排除(32 模块形态)。
                     显式 -P!ai17 可强制排除。insight 在列原因:编译面 import com.bidr.llm(ChatBi 族),
                     llm 产物为 17 字节码——javac 8 连读 classfile(v61)都过不了,JDK8 裸跑必炸
                     (2026-11-06 JDK8 全量复验实证),故与 ai17 同进退 -->
                <jdk>[17,)</jdk>
            </activation>
            <modules>
                <module>ai/llm</module>
                <module>ai/mcp</module>
                <module>ai/agent-runtime</module>
                <module>ai/agent-console</module>
                <!-- 能力装配层（P0a）：llm 协议端口 → store/blob 实现；无 blob 时自动配置整体不装配 -->
                <module>ai/agent-capability</module>
                <module>lowcode/insight</module>
            </modules>
        </profile>

        <!-- JDK9+ 工具链给 surefire 注入模块 opens（经 ${jdk.module.opens}），JDK8 下不激活保持空。
             笔画自 gitee/jdk17 b9b44ad2 同名机制，修正其 java.base/java.invoke 笔误为
             java.lang.invoke（运行时四条 opens 的第四条，java.base 无 java.invoke 包）。
             终局＝MP 3.5.3+ spring-boot3-starter 反射归零后本段整删；
             当前锁 3.5.2＋老 kernel，四包 opens 为硬需求（运行时同款四条），勿因名字或清理误删。 -->
        <profile>
            <id>jdk9plus-module-opens</id>
            <activation>
                <jdk>[9,)</jdk>
            </activation>
            <properties>
                <jdk.module.opens>--add-opens=java.base/java.lang=ALL-UNNAMED --add-opens=java.base/java.lang.reflect=ALL-UNNAMED --add-opens=java.base/java.util=ALL-UNNAMED --add-opens=java.base/java.lang.invoke=ALL-UNNAMED</jdk.module.opens>
            </properties>
        </profile>

        <!-- ===== Central 发布档（2026-11-09 定案）=====
             用法: mvn clean deploy -Pcentral-dist -DjarVersion=<戳> -DskipTests
             前置: ~/.m2/settings.xml 配 server id=central（Portal token）＋ gpg 密钥已推 keyserver
             与内网 Nexus 通道(distributionManagement)互不干扰：不带本档的 deploy 照走 Nexus，
             带本档的 deploy 被 central-publishing-maven-plugin 接管（extensions=true）直传 Portal。
             autoPublish=false＝首发人工闸：Portal 校验过之后人手点 Publish（发布即永久不可撤）；
             火车脚本稳定后可改 true。 -->
        <profile>
            <id>central-dist</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.8.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>false</autoPublish>
                            <waitUntil>validated</waitUntil>
                        </configuration>
                    </plugin>
                    <!-- 打平发布 pom：${jarVersion} 属性版本与字面 parent 版本(0.0.1-SNAPSHOT)在
                         Central 校验下不可解析（jitpack 时代靠它改写 pom 才没炸过）——按有效模型
                         生成自包含发布 pom：版本全部落定、parent 边内联、继承元数据物化进各模块。
                         【pomElements 白名单而非 oss 预设】oss 会保留 distributionManagement——内网
                         Nexus 的 http://10.3.23.193 地址随 pom 发布＝Central 供应链防护（非 HTTPS
                         仓库地址）必打回（首发两轮校验挂同一因）。白名单只留元数据五项；
                         licenses/dependencies 由插件自动解析保留、不在 pomElements 可配之列
                         （写了即报 Cannot find，1.6.0 实测）；其余（distributionManagement/
                         repositories/properties/profiles...）不在名单＝剥离，内网通道零外泄 -->
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>flatten-maven-plugin</artifactId>
                        <version>1.6.0</version>
                        <configuration>
                            <updatePomFile>true</updatePomFile>
                            <pomElements>
                                <name/>
                                <description/>
                                <url/>
                                <developers/>
                                <scm/>
                            </pomElements>
                        </configuration>
                        <executions>
                            <execution>
                                <id>flatten-dist</id>
                                <phase>process-resources</phase>
                                <goals><goal>flatten</goal></goals>
                            </execution>
                            <execution>
                                <id>flatten-clean</id>
                                <phase>clean</phase>
                                <goals><goal>clean</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals><goal>jar-no-fork</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.6.3</version>
                        <configuration>
                            <doclint>none</doclint>
                            <quiet>true</quiet>
                            <charset>UTF-8</charset>
                            <encoding>UTF-8</encoding>
                            <docencoding>UTF-8</docencoding>
                            <failOnError>false</failOnError>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals><goal>jar</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.6</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals><goal>sign</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <!-- surefire 统一吃 ${jdk.module.opens}（JDK8 空 / JDK9+ 四包 opens）；pluginManagement
         下放——模块未自配 surefire 即继承，自配了 argLine 的模块须自行拼接该属性 -->
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <argLine>${jdk.module.opens}</argLine>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- 发布 pom 物化＝全局常态（2026-11-10 从 central-dist 档上提）：install/deploy 产物
                 一律自包含（parent 边内联、版本落定）——发 Nexus（火车）同样需要：占位 pom 出去
                 ＝消费端传递边断（framework 仓「找不到 com.bidr.kernel 类」同款病实证）。
                 oss 模式保留 distributionManagement（发 Nexus 无供应链校验）；
                 central-dist 档内同名插件以 pomElements 白名单覆盖（发 Central 剥内网地址）。 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.6.0</version>
                <configuration>
                    <flattenMode>oss</flattenMode>
                    <updatePomFile>true</updatePomFile>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten-dist</id>
                        <phase>process-resources</phase>
                        <goals><goal>flatten</goal></goals>
                    </execution>
                    <execution>
                        <id>flatten-clean</id>
                        <phase>clean</phase>
                        <goals><goal>clean</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <distributionManagement>
        <repository>
            <id>bidr</id>
            <name>nexus Repository RELEASES</name>
            <url>http://10.3.23.193:8081/repository/maven-releases/</url>
        </repository>

        <snapshotRepository>
            <id>bidr</id>
            <name>nexus Repository SNAPSHOTS</name>
            <url>http://10.3.23.193:8081/repository/maven-snapshots/</url>
        </snapshotRepository>
    </distributionManagement>
</project>
