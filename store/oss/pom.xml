<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>core</artifactId>
        <relativePath>../../pom.xml</relativePath>
        <groupId>io.github.swansrp</groupId>
        <version>${jarVersion}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
            <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
</properties>

    <artifactId>oss</artifactId>
    <name>oss</name>
    <version>${jarVersion}</version>
    <packaging>jar</packaging>

    

    <dependencies>
        <dependency>
            <groupId>io.github.swansrp</groupId>
            <artifactId>kernel</artifactId>
            <version>${kernel.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.swansrp</groupId>
            <artifactId>platform</artifactId>
            <version>${platform.version}</version>
        </dependency>
        <!--
            redis：WikiCollaboratorPortalService 直接 import RedisService（分享链接缓存 set/get/delete）。
            原先靠 authorization(server) 传递供给——D-1 降 authorization-api 后传递断，按"直接用的
            就直接声明"口径（同 agent-console 对 platform 的注释）补直依
        -->
        <dependency>
            <groupId>io.github.swansrp</groupId>
            <artifactId>redis</artifactId>
            <version>${redis.version}</version>
        </dependency>
        <!--
            authorization-api（D-1 依赖收窄降级）：authorization 裸包不再引——TokenService 死注入已删
            （M-14）、ac_user JOIN 已于续笔二摘除——人名走 @BindUser SPI 兜底展开（Mirror/Default 解析器两端各自供给），余下 import 全为 api 包静态
            注解/holder（M-16），下游装配零运行时 bean 依赖；⚠ wiki 端点 @Auth 强制由宿主
            authorization-client 提供（AuthInterceptor 在 client），宿主不带 client 则 wiki 面不设防
        -->
        <dependency>
            <groupId>io.github.swansrp</groupId>
            <artifactId>authorization-api</artifactId>
            <version>${authorization-api.version}</version>
        </dependency>
        <!-- minio -->
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
            <version>8.5.2</version>
        </dependency>
        <!-- 火山引擎 TOS 官方 SDK（TOS 不支持 S3 path-style，minio 客户端无法对接） -->
        <dependency>
            <groupId>com.volcengine</groupId>
            <artifactId>ve-tos-java-sdk</artifactId>
            <version>2.8.6</version>
        </dependency>
        <!-- ali -->
        <dependency>
            <groupId>com.aliyun.oss</groupId>
            <artifactId>aliyun-sdk-oss</artifactId>
            <version>3.5.0</version>
        </dependency>
        <!-- 按对象名直写/直读字节的本机实现回归（无需任何云凭证即可跑） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 传递依赖含 JUnit4 时 surefire 会选错 provider，表现为 Tests run: 0（必须显式指定） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                    </includes>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>org.apache.maven.surefire</groupId>
                        <artifactId>surefire-junit-platform</artifactId>
                        <version>2.22.2</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>

</project>
