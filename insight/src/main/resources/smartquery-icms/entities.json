[
 {
  "name": "SchedulePlan",
  "display_name": "进度计划",
  "aliases": ["计划", "WBS", "施工进度计划"],
  "description": "进度计划 WBS 树：level=1 总控计划（全项目）→ level=2 年度施工进度计划（2025/2026）→ 施工标 → 单位/分部/分项工程；投资/工程量字段父子层级均存值，聚合指标仅取末级（if_last_level=1）避免重复累计；年度口径查询用 full_path_name 锚定（如 contains '/2026年施工进度计划'）；默认仅统计启用且已审核数据",
  "table": "fpim.icms_schedule_plan",
  "primary_key": ["id"],
  "listable": true,
  "display_fields": ["pro_name", "name", "level", "plan_start_date", "plan_end_date", "reality_start_date", "reality_end_date", "invest_price", "finish_rate", "accumulate_proportion", "head_user_name", "paragraph_name"],
  "default_filters": [
   {"field": "enable", "value": 1},
   {"field": "validate_status", "value": 1}
  ],
  "fields": [
   {"name": "id", "display_name": "表ID", "type": "Integer"},
   {"name": "pro_id", "display_name": "项目ID", "type": "Integer"},
   {"name": "pro_name", "display_name": "项目名称", "type": "String", "sensitive": true, "code_field": "pro_id"},
   {"name": "code", "display_name": "单据编码", "type": "String"},
   {"name": "name", "display_name": "名称", "type": "String"},
   {"name": "original_code", "display_name": "原始编码", "type": "String"},
   {"name": "parent_id", "display_name": "上级ID", "type": "Integer"},
   {"name": "parent_name", "display_name": "上级名称", "type": "String"},
   {"name": "type", "display_name": "类型", "type": "String"},
   {"name": "plan_duration", "display_name": "原定工期", "type": "Integer"},
   {"name": "plan_start_date", "display_name": "计划开始", "type": "Date"},
   {"name": "plan_end_date", "display_name": "计划完成", "type": "Date"},
   {"name": "reality_start_date", "display_name": "实际开始", "type": "Date"},
   {"name": "reality_end_date", "display_name": "实际完成", "type": "Date"},
   {"name": "desir_end_date", "display_name": "期望完成", "type": "Date"},
   {"name": "weight", "display_name": "权重", "type": "Decimal"},
   {"name": "head_user_name", "display_name": "责任人", "type": "String"},
   {"name": "level", "display_name": "级次", "type": "Integer"},
   {"name": "if_last_level", "display_name": "是否末级", "type": "Integer", "value_domain": "if_last_level"},
   {"name": "full_path_name", "display_name": "全路径名称", "type": "String"},
   {"name": "paragraph_id", "display_name": "标段ID", "type": "Integer"},
   {"name": "paragraph_name", "display_name": "标段名称", "type": "String"},
   {"name": "unit_project_id", "display_name": "单位工程ID", "type": "Integer"},
   {"name": "period_accumulate_proportion", "display_name": "上期累计占比", "type": "Decimal"},
   {"name": "accumulate_proportion", "display_name": "累计占比", "type": "Decimal"},
   {"name": "latest_feedback_date", "display_name": "最新反馈日期", "type": "Date"},
   {"name": "proportion", "display_name": "完成占比", "type": "Decimal"},
   {"name": "invest_price", "display_name": "投资金额（万元）", "type": "Decimal"},
   {"name": "data_type", "display_name": "数据类型", "type": "String", "value_domain": "data_type"},
   {"name": "work_num", "display_name": "工程数量", "type": "Decimal"},
   {"name": "unit", "display_name": "单位", "type": "String"},
   {"name": "finish_work_num", "display_name": "已完成数量", "type": "Decimal"},
   {"name": "finish_estimate", "display_name": "已完成估投", "type": "Decimal"},
   {"name": "finish_rate", "display_name": "已完成比例", "type": "Decimal"},
   {"name": "project_code", "display_name": "工程编码", "type": "String"}
  ]
 },
 {
  "name": "QualityQbs",
  "display_name": "质量验评（QBS）",
  "aliases": ["验评", "质量验评", "QBS", "分部工程验评"],
  "description": "质量验评 QBS 树（合同工程→单位工程→分部工程→单元工程）；验评结果仅末级单元工程（type=4）有效，验评率/优良率口径均以单元工程为基数；默认仅统计启用且已审核数据",
  "grain": "一行 = 一个 QBS 树节点（验评结论挂在单元工程节点上）",
  "table": "fpim.icms_quality_qbs",
  "primary_key": ["id"],
  "listable": true,
  "display_fields": ["pro_name", "name", "pro_unit_name", "type", "level", "result", "result_date", "record_date"],
  "default_filters": [
   {"field": "enable", "value": 1},
   {"field": "validate_status", "value": 1}
  ],
  "fields": [
   {"name": "id", "display_name": "表ID", "type": "Integer"},
   {"name": "pro_id", "display_name": "项目ID", "type": "Integer"},
   {"name": "pro_name", "display_name": "项目名称", "type": "String", "sensitive": true, "code_field": "pro_id"},
   {"name": "pro_code", "display_name": "项目编码", "type": "String"},
   {"name": "code", "display_name": "编码", "type": "String"},
   {"name": "name", "display_name": "名称", "type": "String"},
   {"name": "pro_unit_id", "display_name": "单位ID", "type": "Integer"},
   {"name": "pro_unit_name", "display_name": "单位名称", "type": "String"},
   {"name": "type", "display_name": "类型", "type": "Integer", "value_domain": "qbs_type"},
   {"name": "level", "display_name": "级次", "type": "Integer"},
   {"name": "if_last_level", "display_name": "是否末级", "type": "Integer", "value_domain": "if_last_level"},
   {"name": "parent_id", "display_name": "上级ID", "type": "Integer"},
   {"name": "parent_name", "display_name": "上级名称", "type": "String"},
   {"name": "full_path_name", "display_name": "全路径名称", "type": "String"},
   {"name": "result", "display_name": "验评结果", "type": "Integer", "value_domain": "qbs_result"},
   {"name": "result_date", "display_name": "验评时间", "type": "Date"},
   {"name": "record_date", "display_name": "备案时间", "type": "Date"},
   {"name": "start_date", "display_name": "开工时间", "type": "Date"},
   {"name": "evaluation_date", "display_name": "评定/验收时间", "type": "Date"},
   {"name": "handle_person", "display_name": "责任人", "type": "String"},
   {"name": "input_person", "display_name": "登记人员", "type": "String"},
   {"name": "input_time", "display_name": "登记时间", "type": "Date"}
  ]
 },
 {
  "name": "InvestMonthly",
  "display_name": "月度投资",
  "aliases": ["月度投资执行单", "当月投资", "投资完成"],
  "description": "月度投资执行单：一行 = 某单位某月完成投资；year/month 为整数年度与月份，finish_price 为当月完成投资（万元）；按单位（标段）pro_unit_name 填报；默认仅统计启用且已审核数据",
  "grain": "一行 = 一个单位在一个月的完成投资（同一单位同月可有多张执行单）",
  "table": "fpim.icms_invest_monthly",
  "primary_key": ["id"],
  "listable": true,
  "display_fields": ["pro_name", "year", "month", "pro_unit_name", "finish_price", "handle_person", "handle_date"],
  "default_filters": [
   {"field": "enable", "value": 1},
   {"field": "validate_status", "value": 1}
  ],
  "fields": [
   {"name": "id", "display_name": "表ID", "type": "Integer"},
   {"name": "pro_id", "display_name": "项目ID", "type": "Integer"},
   {"name": "pro_name", "display_name": "项目名称", "type": "String", "sensitive": true, "code_field": "pro_id"},
   {"name": "pro_code", "display_name": "项目编码", "type": "String"},
   {"name": "code", "display_name": "单据编码", "type": "String"},
   {"name": "name", "display_name": "单据名称", "type": "String"},
   {"name": "year", "display_name": "年度", "type": "Integer"},
   {"name": "month", "display_name": "月度", "type": "Integer"},
   {"name": "handle_person", "display_name": "填报人员", "type": "String"},
   {"name": "handle_date", "display_name": "填报日期", "type": "Date"},
   {"name": "pro_unit_id", "display_name": "单位ID", "type": "Integer"},
   {"name": "pro_unit_name", "display_name": "单位名称", "type": "String"},
   {"name": "finish_price", "display_name": "当月完成投资（万元）", "type": "Decimal"},
   {"name": "input_time", "display_name": "登记时间", "type": "Date"}
  ]
 },
 {
  "name": "ProjectHazard",
  "display_name": "危险源",
  "aliases": ["危险源管理", "安全风险", "隐患"],
  "description": "危险源台账：一行 = 一个危险源；project 为施工项目（如明挖施工/填筑工程），type 为危险源分级（1重大/2较大/3一般），type_class 为类别（施工作业类等），level 为风险等级文本；confirm_status 确认状态：1=当前确认在册，2=已解除确认（cancel_confirm_time 为解除时间）；find_time 为发现时间；各责任人字段均为姓名文本；默认仅统计启用且已审核数据",
  "grain": "一行 = 一个危险源记录",
  "table": "fpim.icms_project_hazard",
  "primary_key": ["id"],
  "listable": true,
  "display_fields": ["source", "project", "type_class", "level", "pro_unit_name", "produce_duty", "find_time", "confirm_status"],
  "default_filters": [
   {"field": "enable", "value": 1},
   {"field": "validate_status", "value": 1}
  ],
  "fields": [
   {"name": "id", "display_name": "主键", "type": "Integer"},
   {"name": "pro_id", "display_name": "项目ID", "type": "Integer"},
   {"name": "pro_name", "display_name": "项目名称", "type": "String", "sensitive": true, "code_field": "pro_id"},
   {"name": "pro_unit_id", "display_name": "标段ID", "type": "Integer"},
   {"name": "pro_unit_name", "display_name": "标段单位名称", "type": "String"},
   {"name": "type", "display_name": "危险源分级", "type": "String", "value_domain": "hazard_type"},
   {"name": "type_class", "display_name": "类别", "type": "String", "value_domain": "hazard_class"},
   {"name": "source", "display_name": "危险源名称", "type": "String"},
   {"name": "accident_type", "display_name": "可能导致事故类型", "type": "String"},
   {"name": "level", "display_name": "风险等级", "type": "String", "value_domain": "hazard_level"},
   {"name": "programme", "display_name": "相关方案", "type": "String"},
   {"name": "measure", "display_name": "控制措施", "type": "String"},
   {"name": "produce_duty", "display_name": "生产负责人", "type": "String"},
   {"name": "technology_duty", "display_name": "技术负责人", "type": "String"},
   {"name": "safe_duty", "display_name": "安全负责人", "type": "String"},
   {"name": "first_duty", "display_name": "项目第一负责人", "type": "String"},
   {"name": "project", "display_name": "施工项目", "type": "String"},
   {"name": "confirm_status", "display_name": "确认状态", "type": "String", "value_domain": "hazard_confirm_status"},
   {"name": "cancel_confirm_time", "display_name": "解除确认时间", "type": "Date"},
   {"name": "find_time", "display_name": "发现时间", "type": "Date"},
   {"name": "input_time", "display_name": "登记时间", "type": "Date"}
  ]
 }
]
