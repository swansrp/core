<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.swansrp</groupId>
        <artifactId>core</artifactId>
        <relativePath>../../pom.xml</relativePath>
        <version>${revision}</version>
    </parent>

    <artifactId>agent-runtime</artifactId>
    <version>${revision}</version>
    <description>外部 Agent Runtime 接入层：provider SPI 实现（agent-system / OpenHands）+ 浏览器中转 relay +
        会话归属映射。SPI 接口本身在 core/llm（com.bidr.llm.agent.runtime.spi），本模块只做实现与中转。</description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
            <java.version>17</java.version>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
</properties>

    

    <dependencies>
        <!-- kernel：spring-boot-starter-web（SseEmitter）/ jackson / mybatis-plus 等基座 -->
        <dependency>
            <groupId>io.github.swansrp</groupId>
            <artifactId>kernel</artifactId>
            <version>${kernel.version}</version>
        </dependency>
        <!-- SPI 与契约 DTO 的宿主：本模块只做实现，接口定义在 core/llm -->
        <dependency>
            <groupId>io.github.swansrp</groupId>
            <artifactId>llm</artifactId>
            <version>${llm.version}</version>
        </dependency>
        <!--
            platform 为可选能力：类路径上有时，配置经系统参数管理页（sys_config）下发并可热改；
            否则全部回落应用配置 my.agent.runtime.*（与 core/llm 的 Param 优先/yaml 回落同一模式）
        -->
        <dependency>
            <groupId>io.github.swansrp</groupId>
            <artifactId>platform</artifactId>
            <version>${platform.version}</version>
            <optional>true</optional>
        </dependency>
        <!-- authorization-api：只用实体审计填充的注解与主体（@AccountContextFill / AccountContext），
             不碰 server 版的 dao/service；原先误依赖 server 件会把 ac_* 带给所有宿主 -->
        <dependency>
            <groupId>io.github.swansrp</groupId>
            <artifactId>authorization-api</artifactId>
            <version>${authorization-api.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/java</directory>
                <includes>
                    <include>**/*.xml</include>
                </includes>
                <filtering>false</filtering>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
        </resources>
        <plugins>
            <!-- 传递依赖含 JUnit4 时 surefire 会选错 provider，表现为 Tests run: 0（必须显式指定） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                    </includes>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>org.apache.maven.surefire</groupId>
                        <artifactId>surefire-junit-platform</artifactId>
                        <version>2.22.2</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>
</project>
