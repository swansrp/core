<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.bidr</groupId>
        <artifactId>core</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>agent-runtime</artifactId>
    <version>${jarVersion}</version>
    <description>外部 Agent Runtime 接入层：provider SPI 实现（agent-system / OpenHands）+ 浏览器中转 relay +
        会话归属映射。SPI 接口本身在 core/llm（com.bidr.llm.agent.runtime.spi），本模块只做实现与中转。</description>

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <profiles>
        <profile>
            <id>development</id>
            <properties>
                <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
                <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
                <java.version>1.8</java.version>
                <jarVersion>0.0.1-SNAPSHOT</jarVersion>
                <kernel.version>${jarVersion}</kernel.version>
                <platform.version>${jarVersion}</platform.version>
                <authorization.version>${jarVersion}</authorization.version>
                <llm.version>${jarVersion}</llm.version>
            </properties>
        </profile>
        <profile>
            <id>public-snapshots</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
                <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
                <java.version>1.8</java.version>
                <kernel.version>20260917080727-70</kernel.version>
                <platform.version>20260917080727-70</platform.version>
                <authorization.version>20260917080727-70</authorization.version>
                <llm.version>20260917080727-70</llm.version>
            </properties>
        </profile>
    </profiles>

    <dependencies>
        <!-- kernel：spring-boot-starter-web（SseEmitter）/ jackson / mybatis-plus 等基座 -->
        <dependency>
            <groupId>com.bidr</groupId>
            <artifactId>kernel</artifactId>
            <version>${kernel.version}</version>
        </dependency>
        <!-- SPI 与契约 DTO 的宿主：本模块只做实现，接口定义在 core/llm -->
        <dependency>
            <groupId>com.bidr</groupId>
            <artifactId>llm</artifactId>
            <version>${llm.version}</version>
        </dependency>
        <!--
            platform 为可选能力：类路径上有时，配置经系统参数管理页（sys_config）下发并可热改；
            否则全部回落应用配置 my.agent.runtime.*（与 core/llm 的 Param 优先/yaml 回落同一模式）
        -->
        <dependency>
            <groupId>com.bidr</groupId>
            <artifactId>platform</artifactId>
            <version>${platform.version}</version>
            <optional>true</optional>
        </dependency>
        <!-- authorization：实体审计填充（@AccountContextFill），与 core/insight 同款 -->
        <dependency>
            <groupId>com.bidr</groupId>
            <artifactId>authorization</artifactId>
            <version>${authorization.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/java</directory>
                <includes>
                    <include>**/*.xml</include>
                </includes>
                <filtering>false</filtering>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
        </resources>
        <plugins>
            <!-- 传递依赖含 JUnit4 时 surefire 会选错 provider，表现为 Tests run: 0（必须显式指定） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                    </includes>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>org.apache.maven.surefire</groupId>
                        <artifactId>surefire-junit-platform</artifactId>
                        <version>2.22.2</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>
</project>
