<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>core</artifactId>
        <relativePath>../../pom.xml</relativePath>
        <groupId>io.github.swansrp</groupId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
            <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
</properties>

    <artifactId>document</artifactId>
    <version>${jarVersion}</version>
    <packaging>jar</packaging>

    

    <dependencies>
        <!-- MinerU 客户端：本模块内置增强转写腿 MineruTranscribeLeg 的实现件，
             处理路径自带（依赖方向＝document → mineru，mineru 不反向依赖本模块） -->
        <dependency>
            <groupId>io.github.swansrp</groupId>
            <artifactId>mineru</artifactId>
            <version>${mineru.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!-- 内置腿：Office 新格式 docx/xlsx/pptx；版本与 jxls-poi 带入的 POI 4.1.2 对齐（沿用 llm 的对齐注释），
             避免 4/5 两代 schema jar 混版冲突 -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>4.1.2</version>
        </dependency>
        <!-- 内置腿：Office 旧格式 doc/ppt 文本提取（4.1.2 含 WordExtractor/PowerPointExtractor） -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-scratchpad</artifactId>
            <version>4.1.2</version>
        </dependency>
        <!-- 内置腿：PDF 文本提取，扫描页渲染为图片后交多模态转录 -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>2.0.31</version>
        </dependency>
        <!-- 内置腿：HTML 转 Markdown -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>1.17.2</version>
        </dependency>
        <!-- lc4j 触点已整体迁 ai/llm（C′ 迁移 2026-11-07，langchain4j 1.x 全家 Java17 字节码，
             本模块留 JDK8 必须 zero-lc4j）：多模态真实现＝com.bidr.llm.document.LlmVisionTranscriber、
             read_file 工具＝com.bidr.llm.document.FileMarkdownTool；本模块只留
             VisionTranscriber 接口＋NoopVisionTranscriber 占位（被调即抛操作指引） -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 传递依赖含 JUnit4 时 surefire 会选错 provider，表现为 Tests run: 0（必须显式指定） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                    </includes>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>org.apache.maven.surefire</groupId>
                        <artifactId>surefire-junit-platform</artifactId>
                        <version>2.22.2</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>

</project>
