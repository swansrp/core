<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>core</artifactId>
        <relativePath>../../pom.xml</relativePath>
        <groupId>io.github.swansrp</groupId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
            <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
</properties>

    <artifactId>engine-file-parse</artifactId>
    <version>${jarVersion}</version>
    <packaging>jar</packaging>

    

    <dependencies>
        <!-- 编排车床（@AsyncTaskType/@AsyncStage 三态阶段 + sa_async_task 台账） -->
        <dependency>
            <groupId>io.github.swansrp</groupId>
            <artifactId>base-task</artifactId>
            <version>${jarVersion}</version>
        </dependency>
        <!-- 产物存储（BlobStore 八前缀键正源 + sa_blob 台账） -->
        <dependency>
            <groupId>io.github.swansrp</groupId>
            <artifactId>store-blob</artifactId>
            <version>${jarVersion}</version>
        </dependency>
        <!-- 加工门面（DocumentProcessor 内置直读 + ConvertStep 外挂腿 + AsyncTranscribeLeg 异步口；
             不直接依赖 tool/mineru / tool/gotenberg——腿装不装由 classpath 决定，经 document 间接） -->
        <dependency>
            <groupId>io.github.swansrp</groupId>
            <artifactId>document</artifactId>
            <version>${jarVersion}</version>
        </dependency>
        <!-- 页图渲染（PageImageRenderer 的 PDFBox）：本模块直依件必须显式声明（A13——
           此前只靠 document 传递，fat jar 闭包里没有它＝NoClassDefFoundError 运行时爆）。
           版本对齐 document 的 POI 4.1.2 兼容口径 -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>2.0.31</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 传递依赖含 JUnit4 时 surefire 会选错 provider，表现为 Tests run: 0（必须显式指定） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                    </includes>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>org.apache.maven.surefire</groupId>
                        <artifactId>surefire-junit-platform</artifactId>
                        <version>2.22.2</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>

</project>
